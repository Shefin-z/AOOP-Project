PORT=4000
# Spring Boot API configuration (run with: npm run dev:api)
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=careerforge
MYSQL_PASSWORD=careerforge
MYSQL_DATABASE=careerforge
MYSQL_SSL=false
# A comma-separated allow-list. Add the Vercel deployment URL in production.
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Set true only after database/schema.sql has initialized a database.
FLYWAY_ENABLED=false
# Used once to create the initial private admin account. Remove these after the
# first successful backend start; the account will not be overwritten.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Vite uses this only in production. It must end with /api.
VITE_API_URL=
# TiDB variables may be used instead of MYSQL_*.
TIDB_HOST=
TIDB_PORT=
TIDB_USER=
TIDB_PASSWORD=
TIDB_DATABASE=
AI_SERVICE_URL=http://localhost:8000
