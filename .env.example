PORT=4000
JWT_SECRET=replace-with-a-long-random-string
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=careerforge
MYSQL_PASSWORD=careerforge
MYSQL_DATABASE=careerforge
MYSQL_SSL=false
# Vercel's TiDB integration can provide TIDB_HOST, TIDB_PORT, TIDB_USER,
# TIDB_PASSWORD and TIDB_DATABASE instead of the MYSQL_* variables.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
AI_SERVICE_URL=http://localhost:8000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Use gmail without buying a custom domain. A Google App Password requires
# 2-Step Verification and must never be committed.
EMAIL_PROVIDER=gmail
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM=CareerForge <your-email@gmail.com>
EMAIL_VERIFICATION_SECRET=replace-with-an-independent-long-random-string
# Optional alternative provider for a verified Resend domain.
RESEND_API_KEY=
# Local development only. Hosted production never permits console delivery.
EMAIL_DELIVERY_MODE=console
