# Copy this file to .env, then add your API credentials below.
# .env is ignored by Git and must never be committed.
GEMINI_API_KEY=
# Optional: leave this default unless you have chosen another Gemini model.
GEMINI_MODEL=gemini-3.6-flash

# YouTube Data API v3 resource importer.
YOUTUBE_API_KEY=

# Local MySQL defaults. Change only if your MySQL setup uses different values.
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=careerforge
# DB_USERNAME=root
# DB_PASSWORD=

# Optional. Remotive's public job API does not require an API key.
# Keep this default unless you need a smaller import batch or a compatible endpoint.
# REMOTIVE_JOBS_URL=https://remotive.com/api/remote-jobs?limit=20

# Optional JSearch / RapidAPI configuration. If RAPIDAPI_KEY is set, the admin import button
# automatically uses JSearch instead of the no-key Remotive fallback.
RAPIDAPI_KEY=
RAPIDAPI_HOST=jsearch.p.rapidapi.com
JSEARCH_URL=https://jsearch.p.rapidapi.com/search-v2?query=software%20engineer%20intern&page=1&num_pages=1&date_posted=week
BDJOBS_URL=https://jobs.bdjobs.com/jobsearch.asp
