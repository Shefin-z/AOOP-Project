{
  "name": "careerforge",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "cd backend && mvn spring-boot:run",
    "dev:all": "concurrently -n WEB,API -c blue,green \"npm run dev\" \"npm run dev:api\"",
    "build": "vite build",
    "preview": "vite preview",
    "start:api": "cd backend && mvn spring-boot:run",
    "start": "vite preview --host 0.0.0.0 --port 3000"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "happy-dom": "^20.11.1",
    "postcss": "^8.5.24",
    "tailwindcss": "^3.4.17",
    "vite": "^7.2.2"
  }
}
